{
  "name": "sgm-plan-package-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "plan": "node --import tsx src/server/plan-cli.ts",
    "accept": "tsx src/server/accept-package.ts",
    "dev": "tsx src/server/cli.ts",
    "lint": "eslint .",
    "measure": "tsx src/server/measure-runtime.ts",
    "publish": "tsx src/server/publish-package.ts",
    "record-result": "tsx src/server/record-result.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
